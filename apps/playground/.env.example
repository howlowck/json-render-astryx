# Optional defaults for the playground's Ollama connection. Both are also
# editable at runtime in the playground UI.
#
# The playground calls your LOCAL Ollama server DIRECTLY FROM THE BROWSER. You
# must have Ollama running and the model pulled (e.g. `ollama pull gpt-oss`).
# If the browser is blocked by CORS, allow the dev origin, e.g.:
#   OLLAMA_ORIGINS=http://localhost:5173 ollama serve
# If Ollama is unreachable, the playground falls back to offline mock specs.
VITE_OLLAMA_MODEL=gpt-oss
VITE_OLLAMA_PORT=11434
