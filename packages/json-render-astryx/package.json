{
  "name": "json-render-astryx",
  "version": "0.1.3",
  "description": "Generative UI component library binding json-render to Meta's Astryx components. JSON becomes Astryx-styled React components.",
  "keywords": [
    "json-render",
    "astryx",
    "generative-ui",
    "ai",
    "llm",
    "react",
    "renderer",
    "streaming",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlowck/json-render-astryx.git",
    "directory": "packages/json-render-astryx"
  },
  "homepage": "https://howlowck.github.io/json-render-astryx/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./catalog": {
      "import": {
        "types": "./dist/catalog.d.mts",
        "default": "./dist/catalog.mjs"
      },
      "require": {
        "types": "./dist/catalog.d.cts",
        "default": "./dist/catalog.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@astryxdesign/core": "^0.3.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astryxdesign/core": "^0.3.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
